# =============================================================================
# Cool — environment template.
# Copy to `.env` and fill in. All values are optional unless noted.
# `docker compose` loads `.env` automatically (env_file); for a source install,
# export the variables (or source the file) before running `cool`.
# =============================================================================

# --- Runtime ---
# Data root: SQLite stores, artifacts, plugins, settings.json.
# Defaults to ./data; the Docker image pins /var/lib/cool.
# COOL_DATA_DIR=data
# Host port published by docker-compose (`127.0.0.1:${COOL_PORT:-8000}:8000`).
# COOL_PORT=8000
# Bearer token required when `cool serve` binds beyond loopback
# (--allow-remote / server profile). Generate one for Docker:
#   openssl rand -hex 24
COOL_API_TOKEN=
# Fernet key encrypting stored provider API keys at rest (32 url-safe base64
# bytes). Required to read/write stored keys:
#   openssl rand -base64 32
SECRET_KEY=
# Optional override for the built-in system prompt.
# SYSTEM_PROMPT_FILE=/absolute/path/to/system_prompt.txt

# --- LLM credentials (dev / fallback) ---
# Primary config is the Providers UI (stored encrypted in the DB). These env
# vars are used when no Provider row exists yet (local dev, tests).
#   COOL_PROVIDER=openai|anthropic|gemini — pick the backend explicitly (optional)
#   COOL_MODEL=<model id>          — override the default model (optional)
# OpenAI-compatible at OPENAI_BASE_URL:
#   OpenRouter:  https://openrouter.ai/api/v1
#   DeepSeek:    https://api.deepseek.com/v1
#   Groq:        https://api.groq.com/openai/v1
#   Ollama:      http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Native Anthropic (Claude) Messages API.
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Native Google Gemini (streamGenerateContent). Without a key, `cool auth
# gemini` stores Google OAuth tokens (Fernet-encrypted) that the driver uses
# instead — see README's OAuth section.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Google OAuth client for `cool auth gemini` — NOT committed to the repo
# (secret scanners block it). Export the public desktop client id/secret
# Google ships with gemini-cli; without them the flow returns
# `oauth_client_unconfigured`.
COOL_GOOGLE_CLIENT_ID=
COOL_GOOGLE_CLIENT_SECRET=

# --- Web tools ---
# SEARCH_PROVIDER selects the search backend for `web_search` (empty = disabled).
#   serper  — requires SERPER_API_KEY
#   tavily  — requires TAVILY_API_KEY
#   searxng — requires SEARXNG_URL (self-hosted metasearch)
SEARCH_PROVIDER=
SERPER_API_KEY=
TAVILY_API_KEY=
SEARXNG_URL=
# `web_fetch` egress policy: comma-separated public-domain allowlist (or JSON
# array); empty = all public domains. Response cap in bytes (0 = hard cap).
NETWORK_ALLOWED_DOMAINS=
NETWORK_MAX_RESPONSE_BYTES=

# --- Compatibility workers (opt-in sidecars, never on the default path) ---
# OpenCode Bun worker: executable spec resolved by the extension runtime.
# COOL_OPENCODE_WORKER=
# Codex / Claude compatibility adapters (external CLIs):
# COOL_CODEX_WORKER=
# COOL_CLAUDE_WORKER=
